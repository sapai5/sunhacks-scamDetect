# Copy to backend/twilio/.env (gitignored). Never commit the real file.
# Twilio console > Account info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# The trial number Twilio gave you, E.164
TWILIO_NUMBER=+15555550100
# Trial accounts only: calls to your verified phone must come from the "assigned trial number"
# shown on the console's Try out Voice page (it can differ from TWILIO_NUMBER). Leave empty after upgrading.
TWILIO_DIAL_FROM=
# The tunnel URL (cloudflared prints it), no trailing slash
PUBLIC_URL=https://example.trycloudflare.com
PORT=8080
# Optional: link in texts to the elder (defaults to the Amplify app). Texts are off unless TWILIO_TEXTS=1 (a trial account refuses them).
WEB_URL=
# TWILIO_TEXTS=1

# Optional: the takeover agent's voice. Default is Amazon Nova Sonic (a live two-way conversation);
# AGENT_VOICE=say falls back to Twilio <Say> with one Agent Lambda line per turn.
# AGENT_VOICE=say

# Optional: AWS profile for Transcribe only, when the account running the backend has no Transcribe
# subscription (set it in the shell, e.g. $env:TRANSCRIBE_AWS_PROFILE='default', or here).
# TRANSCRIBE_AWS_PROFILE=default
