# Copy to backend/twilio/.env (gitignored). Never commit the real file.
# Twilio console > Account info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# The trial number Twilio gave you, E.164
TWILIO_NUMBER=+15555550100
# The tunnel URL (cloudflared prints it), no trailing slash
PUBLIC_URL=https://example.trycloudflare.com
PORT=8080
