    "@aws-sdk/client-kinesis-video-archived-media": "^3.1169.0",
    "@aws-sdk/client-service-quotas": "^3.1169.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
